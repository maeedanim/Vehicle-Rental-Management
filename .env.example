# Application
NODE_ENV=development
PORT=5000

# PostgreSQL Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vehicle_rental_db
DB_USER=postgres
DB_PASSWORD=your_database_password

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# File Uploads
UPLOAD_PATH=uploads
