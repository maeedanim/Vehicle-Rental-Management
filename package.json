{
  "name": "vehicle-rental-management",
  "version": "1.0.0",
  "description": "Vehicle Rental Management Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:test": "tsx src/config/database-test.ts",
    "migrate": "knex --knexfile knexfile.ts --env development migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.ts --env development migrate:rollback",
    "seed": "knex --knexfile knexfile.ts --env development seed:run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maeedanim/Vehicle-Rental-Management.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/maeedanim/Vehicle-Rental-Management/issues"
  },
  "homepage": "https://github.com/maeedanim/Vehicle-Rental-Management#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
